{
    "permissions": {
        "allow": ["Bash(./pr-risk.sh *)", "Bash(./merge-low-risk.sh *)", "Bash(./gh-rest.sh *)"],
        "deny": [
            "Bash(gh pr merge *)",
            "Bash(gh api *merge*)",
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(git push * --force*)",
            "Bash(git push * -f*)",
            "Bash(git push *--force-with-lease*)",
            "Bash(git push origin main*)",
            "Bash(git push origin HEAD:main*)",
            "Bash(git push * main)"
        ]
    }
}
