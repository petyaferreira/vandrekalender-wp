#!/bin/bash

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

PROJECT_ROOT="$(git rev-parse --show-toplevel)"
cd "$PROJECT_ROOT"

HAS_ERRORS=0

# --- PHPCS: staged PHP files ---------------------------------------------

if [ ! -f "./vendor/bin/phpcs" ]; then
    echo -e "${RED}Error: PHP CodeSniffer not found. Run 'composer install' first.${NC}"
    exit 1
fi

PHP_STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$')

if [ -z "$PHP_STAGED_FILES" ]; then
    echo -e "${GREEN}No PHP files to check.${NC}"
else
    echo -e "${YELLOW}Checking PHP coding standards for staged files...${NC}"

    # Check the staged version through stdin under its real path, so the
    # path-scoped <exclude-pattern> rules in phpcs.xml (e.g. tests/*) apply.
    # A copy in a temp dir did not match them (#69); Prettier does the same (#56).
    phpcs_staged() {
        git show ":$1" | ./vendor/bin/phpcs --standard=phpcs.xml --report=full --stdin-path="$1" -
    }

    for FILE in $PHP_STAGED_FILES; do
        if [ ! -f "$FILE" ]; then
            continue
        fi

        echo "Checking: $FILE"
        if phpcs_staged "$FILE"; then
            echo -e "${GREEN}✓ $FILE${NC}"
            continue
        fi

        # Auto-fixing rewrites the working-tree file and re-stages all of it,
        # which would commit unstaged hunks too (#64).
        if ! git diff --quiet -- "$FILE"; then
            HAS_ERRORS=1
            echo -e "${RED}✗ $FILE has unstaged changes, so it is not auto-fixed. Fix it, then stage it:${NC}"
            echo "    ./vendor/bin/phpcbf $FILE && git add $FILE"
            echo "  (git add stages all of the file; to keep some changes out, stage the hunks with git add -p instead)"
            continue
        fi

        echo -e "${YELLOW}  Auto-fixing: ./vendor/bin/phpcbf $FILE${NC}"
        ./vendor/bin/phpcbf "$FILE" >/dev/null 2>&1
        git add "$FILE"

        if phpcs_staged "$FILE"; then
            echo -e "${GREEN}✓ $FILE (auto-fixed and re-staged)${NC}"
        else
            HAS_ERRORS=1
            echo -e "${RED}✗ Violations remain in: $FILE (not auto-fixable)${NC}"
        fi
    done
fi

# --- Prettier: staged JS/SCSS/CSS/JSON files ------------------------------

if [ ! -f "./node_modules/.bin/prettier" ]; then
    echo -e "${RED}Error: Prettier not found. Run 'npm install' first.${NC}"
    exit 1
fi

PRETTIER_STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.js' '*.jsx' '*.scss' '*.css' '*.json' | grep -v -E '(^|/)(node_modules|build|public)/')

if [ -z "$PRETTIER_STAGED_FILES" ]; then
    echo -e "${GREEN}No JS/SCSS/CSS/JSON files to check.${NC}"
else
    echo -e "${YELLOW}Checking Prettier formatting for staged files...${NC}"

    while IFS= read -r FILE; do
        if [ ! -f "$FILE" ]; then
            continue
        fi

        # Check the staged version through stdin under its real path, so
        # Prettier finds .prettierrc and .prettierignore. A copy in a temp
        # dir would be checked against Prettier's defaults instead (#56).
        if git show ":$FILE" | ./node_modules/.bin/prettier --check --stdin-filepath "$FILE" >/dev/null 2>&1; then
            echo -e "${GREEN}✓ $FILE${NC}"
            continue
        fi

        # Same reason as for PHP above (#64).
        if ! git diff --quiet -- "$FILE"; then
            HAS_ERRORS=1
            echo -e "${RED}✗ $FILE has unstaged changes, so it is not auto-fixed. Fix it, then stage it:${NC}"
            echo "    npx prettier --write $FILE && git add $FILE"
            echo "  (git add stages all of the file; to keep some changes out, stage the hunks with git add -p instead)"
            continue
        fi

        echo -e "${YELLOW}  Auto-fixing: npx prettier --write $FILE${NC}"
        ./node_modules/.bin/prettier --write "$FILE" >/dev/null 2>&1
        git add "$FILE"
        echo -e "${GREEN}✓ $FILE (auto-fixed and re-staged)${NC}"
    done <<<"$PRETTIER_STAGED_FILES"
fi

if [ $HAS_ERRORS -eq 1 ]; then
    echo -e "${RED}"
    echo "=================================================="
    echo "COMMIT REJECTED — see the files marked ✗ above: PHPCS"
    echo "violations that phpcbf can't fix, or files with unstaged"
    echo "changes that were not auto-fixed. Fix them, then commit again:"
    echo "  ./vendor/bin/phpcs <file>  — see remaining violations"
    echo "=================================================="
    echo -e "${NC}"
    exit 1
fi

echo -e "${GREEN}All staged files pass standards. ✓${NC}"
exit 0
