{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "vandrekalender/month-quick-filter",
    "title": "Month Quick Filter",
    "category": "allevandreture",
    "description": "A row of month chips (\"Jump to month\") that filter the calendar, cards, map or past walks list to one month.",
    "textdomain": "vandrekalender-events",
    "editorScript": "file:./index.js",
    "viewScript": "file:./view.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php",
    "attributes": {
        "direction": {
            "type": "string",
            "enum": ["past", "future"],
            "default": "future"
        }
    },
    "supports": {
        "html": false,
        "align": ["wide", "full"]
    }
}
