{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "vandrekalender/organiser-list",
    "title": "Organiser List",
    "category": "widgets",
    "description": "Organisers with a page: \"Andre arrangører\" under an organiser page, or all of them on the overview.",
    "textdomain": "vandrekalender-events",
    "usesContext": ["postId", "postType"],
    "attributes": {
        "show": {
            "type": "string",
            "enum": ["others", "all"],
            "default": "others"
        }
    },
    "editorScript": "file:./index.js",
    "style": "file:./style-index.css",
    "render": "file:./render.php",
    "supports": {
        "align": ["wide"],
        "html": false,
        "inserter": false
    }
}
