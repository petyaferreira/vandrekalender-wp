#: includes/class-facebook-importer.php:569
#, php-format
msgid "%d draft created with details from Facebook"
msgid_plural "%d drafts created with details from Facebook"
msgstr[0] "%d kladde oprettet med detaljer fra Facebook"
msgstr[1] "%d kladder oprettet med detaljer fra Facebook"

#. translators: %d: number of drafts.
#: includes/class-facebook-importer.php:573
#, php-format
msgid "%d empty draft created (Facebook exposed no details — fill in manually)"
msgid_plural "%d empty drafts created (Facebook exposed no details — fill in manually)"
msgstr[0] "%d tom kladde oprettet (Facebook viste ingen detaljer — udfyld manuelt)"
msgstr[1] "%d tomme kladder oprettet (Facebook viste ingen detaljer — udfyld manuelt)"

#. translators: %d: number of events.
#: includes/class-facebook-importer.php:577
#, php-format
msgid "%d already imported and left untouched"
msgid_plural "%d already imported and left untouched"
msgstr[0] "%d var allerede importeret og blev ikke ændret"
msgstr[1] "%d var allerede importeret og blev ikke ændret"

#. translators: %d: number of URLs.
#: includes/class-facebook-importer.php:581
#, php-format
msgid "%d line was not a Facebook event URL"
msgid_plural "%d lines were not Facebook event URLs"
msgstr[0] "%d linje var ikke et link til en Facebook-begivenhed"
msgstr[1] "%d linjer var ikke links til Facebook-begivenheder"

#. translators: %d: number of events.
#: includes/class-facebook-importer.php:585
#, php-format
msgid "%d draft could not be created"
msgid_plural "%d drafts could not be created"
msgstr[0] "%d kladde kunne ikke oprettes"
msgstr[1] "%d kladder kunne ikke oprettes"

#: includes/class-facebook-importer.php:592
msgid "The new drafts are listed below — complete and publish each one."
msgstr "De nye kladder står nedenfor — gør hver enkelt færdig, og udgiv den."

#: includes/class-facebook-importer.php:613
msgid "Collect links from a Facebook group"
msgstr "Saml links fra en Facebook-gruppe"

#: includes/class-facebook-importer.php:614
msgid "Group event lists are only visible when you are logged in to Facebook, so they cannot be fetched automatically. Instead, drag this button to your browser's bookmarks bar once:"
msgstr "En gruppes liste over begivenheder kan kun ses, når du er logget ind på Facebook, så den kan ikke hentes automatisk. Træk i stedet denne knap op på din browsers bogmærkelinje én gang:"

#: includes/class-facebook-importer.php:615
msgid "Drag this button to your bookmarks bar instead of clicking it. Then use it while viewing a Facebook events page."
msgstr "Træk denne knap op på bogmærkelinjen i stedet for at klikke på den. Brug den derefter, mens du ser en side med Facebook-begivenheder."

#: includes/class-facebook-importer.php:615
msgid "★ Collect Facebook event links"
msgstr "★ Saml links til Facebook-begivenheder"

#: includes/class-facebook-importer.php:616
msgid "Then, whenever you want to import: open the group's events page on Facebook (e.g. facebook.com/groups/…/events), scroll so the events you want are loaded, click the bookmarklet, and paste the copied links into the field above."
msgstr "Når du så vil importere: åbn gruppens side med begivenheder på Facebook (f.eks. facebook.com/groups/…/events), rul, så de begivenheder du vil have er indlæst, klik på bogmærket, og indsæt de kopierede links i feltet ovenfor."

