#: blocks/event-calendar/block.json build/blocks/event-calendar/block.json
msgctxt "block title"
msgid "Event Calendar"
msgstr "Begivenhedskalender"

#: blocks/event-calendar/block.json build/blocks/event-calendar/block.json
msgctxt "block description"
msgid "A month calendar that marks days with walking events. Click a day to see its events."
msgstr "En månedskalender der markerer dage med vandreture. Klik på en dag for at se dagens begivenheder."

#: blocks/event-cards/block.json build/blocks/event-cards/block.json
msgctxt "block title"
msgid "Event Cards"
msgstr "Begivenhedskort"

#: blocks/event-cards/block.json build/blocks/event-cards/block.json
msgctxt "block description"
msgid "Displays matching walking events as a grid of cards."
msgstr "Viser matchende vandreture som et gitter af kort."

#: blocks/event-filters/block.json build/blocks/event-filters/block.json
msgctxt "block title"
msgid "Event Filters"
msgstr "Begivenhedsfiltre"

#: blocks/event-filters/block.json build/blocks/event-filters/block.json
msgctxt "block description"
msgid "Filter controls for the event calendar."
msgstr "Filtre til begivenhedskalenderen."

#: blocks/event-info-card/block.json build/blocks/event-info-card/block.json
msgctxt "block title"
msgid "Event Info Card"
msgstr "Begivenhedsinfokort"

#: blocks/event-info-card/block.json build/blocks/event-info-card/block.json
msgctxt "block description"
msgid "Sticky booking summary for a single event: price, date, place, and a route switcher for start time and cutoff time, with either a \"Jeg kommer\" sign-up or a link to the organiser's booking page."
msgstr "Fastgjort opsummering for en enkelt begivenhed: pris, dato, sted og et ruteskift for starttid og makstid, med enten en \"Jeg kommer\"-tilmelding eller et link til arrangørens bookingside."

#: blocks/event-map/block.json build/blocks/event-map/block.json
msgctxt "block title"
msgid "Event Map"
msgstr "Kort over begivenheder"

#: blocks/event-map/block.json build/blocks/event-map/block.json
msgctxt "block description"
msgid "A map of Denmark with a pin for each walking event. Built on Leaflet + OpenStreetMap."
msgstr "Et kort over Danmark med en markør for hver vandretur. Bygget på Leaflet + OpenStreetMap."

#: blocks/event-route-map/block.json build/blocks/event-route-map/block.json
msgctxt "block title"
msgid "Event Route Map"
msgstr "Rutekort"

#: blocks/event-route-map/block.json build/blocks/event-route-map/block.json
msgctxt "block description"
msgid "Shows the GPX track(s) attached to an event's routes on a Leaflet map, with a download link per route. Renders nothing when no route has a GPX file."
msgstr "Viser GPX-sporene fra en begivenheds ruter på et Leaflet-kort med et downloadlink pr. rute. Viser intet, hvis ingen rute har en GPX-fil."

#: blocks/link-box/block.json build/blocks/link-box/block.json
msgctxt "block title"
msgid "Link Box"
msgstr "Linkboks"

#: blocks/link-box/block.json build/blocks/link-box/block.json
msgctxt "block description"
msgid "A container that turns all of its content into a single link. Don't place other links or buttons inside it."
msgstr "En container, der gør hele sit indhold til ét link. Placér ikke andre links eller knapper i den."

#: blocks/organiser-badge/block.json build/blocks/organiser-badge/block.json
msgctxt "block title"
msgid "Official Organiser Badge"
msgstr "Mærket Officiel arrangør"

#: blocks/organiser-badge/block.json build/blocks/organiser-badge/block.json
msgctxt "block description"
msgid "The \"Officiel arrangør\" badge, shown only when the organiser page is flagged as official."
msgstr "Mærket \"Officiel arrangør\", som kun vises, når arrangørsiden er markeret som officiel."

#: blocks/organiser-list/block.json build/blocks/organiser-list/block.json
msgctxt "block title"
msgid "Organiser List"
msgstr "Arrangørliste"

#: blocks/organiser-list/block.json build/blocks/organiser-list/block.json
msgctxt "block description"
msgid "Organisers with a page: \"Andre arrangører\" under an organiser page, or all of them on the overview."
msgstr "Arrangører med en side: \"Andre arrangører\" under en arrangørside, eller dem alle på oversigten."

#: blocks/organiser-logo/block.json build/blocks/organiser-logo/block.json
msgctxt "block title"
msgid "Organiser Logo"
msgstr "Arrangørlogo"

#: blocks/organiser-logo/block.json build/blocks/organiser-logo/block.json
msgctxt "block description"
msgid "The organiser page's logo: its featured image, or the organiser's initials until it has one."
msgstr "Arrangørsidens logo: det fremhævede billede, eller arrangørens forbogstaver indtil der er et."

#: blocks/organiser-regions/block.json
#: build/blocks/organiser-regions/block.json
msgctxt "block title"
msgid "Organiser Regions"
msgstr "Arrangørens regioner"

#: blocks/organiser-regions/block.json
#: build/blocks/organiser-regions/block.json
msgctxt "block description"
msgid "The regions where the organiser has upcoming walks, each linking to its walks there."
msgstr "Regionerne hvor arrangøren har kommende ture, hver med link til turene dér."

#: blocks/organiser-stats/block.json build/blocks/organiser-stats/block.json
msgctxt "block title"
msgid "Organiser Stats"
msgstr "Arrangøren i tal"

