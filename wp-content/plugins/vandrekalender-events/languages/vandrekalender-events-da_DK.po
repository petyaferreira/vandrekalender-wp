msgctxt "block description"
msgid "The organiser's numbers, computed from its upcoming walks."
msgstr "Arrangørens tal, beregnet ud fra de kommende ture."

#: blocks/past-walks/block.json build/blocks/past-walks/block.json
msgctxt "block title"
msgid "Past Walks"
msgstr "Tidligere ture"

#: blocks/past-walks/block.json build/blocks/past-walks/block.json
msgctxt "block description"
msgid "The past walks page /tidligere-ture/: intro, tabs, filters and the walks of the last months grouped by month, with pages."
msgstr "Siden med tidligere ture /tidligere-ture/: intro, faner, filtre og turene fra de seneste måneder grupperet efter måned, med sider."

#: blocks/slider-slide/block.json build/blocks/slider-slide/block.json
msgctxt "block title"
msgid "Slider Slide"
msgstr "Slide"

#: blocks/slider-slide/block.json build/blocks/slider-slide/block.json
msgctxt "block description"
msgid "A single slide within slider slides block."
msgstr "Et enkelt slide i en slider-blok."

#: blocks/slider/block.json build/blocks/slider/block.json
msgctxt "block title"
msgid "Slider"
msgstr "Slider"

#: blocks/slider/block.json build/blocks/slider/block.json
msgctxt "block description"
msgid "Slider block for displaying content in a sliding format."
msgstr "Slider-blok, der viser indhold som skiftende slides."

#: blocks/tab/block.json build/blocks/tab/block.json
msgctxt "block title"
msgid "Tab"
msgstr "Faneblad"

#: blocks/tab/block.json build/blocks/tab/block.json
msgctxt "block description"
msgid "A single tab panel. Place any blocks inside. Lives inside a Tabs block."
msgstr "Et enkelt fanebladspanel. Placér vilkårlige blokke i det. Ligger i en Faneblade-blok."

