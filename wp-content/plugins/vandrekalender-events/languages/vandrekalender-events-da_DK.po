msgstr "Datafordeler er ikke sat op (VANDREKALENDER_DATAFORDELER_API_KEY mangler), så der kunne ikke findes kommune eller adresse ud fra koordinater."

#: includes/class-geocoder.php:556
msgid "Skipped a Datafordeler lookup because Datafordeler failed earlier in this run."
msgstr "Et opslag i Datafordeler blev sprunget over, fordi Datafordeler fejlede tidligere i denne kørsel."

#. translators: %s: error message from the HTTP request.
#: includes/class-geocoder.php:578
#, php-format
msgid "Datafordeler request failed: %s"
msgstr "Kaldet til Datafordeler fejlede: %s"

#: includes/class-geocoder.php:591
