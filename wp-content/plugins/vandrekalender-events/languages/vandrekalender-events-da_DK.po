msgid "Event Route Map"
msgstr "Rutekort"

#: blocks/event-route-map/block.json build/blocks/event-route-map/block.json
msgctxt "block description"
msgid "Shows the GPX track(s) attached to an event's routes on a Leaflet map, with a download link per route. Renders nothing when no route has a GPX file."
msgstr "Viser GPX-sporene fra en begivenheds ruter på et Leaflet-kort med et downloadlink pr. rute. Viser intet, hvis ingen rute har en GPX-fil."

#: blocks/link-box/block.json build/blocks/link-box/block.json
msgctxt "block title"
msgid "Link Box"
msgstr "Linkboks"

#: blocks/link-box/block.json build/blocks/link-box/block.json
msgctxt "block description"
msgid "A container that turns all of its content into a single link. Don't place other links or buttons inside it."
msgstr "En container, der gør hele sit indhold til ét link. Placér ikke andre links eller knapper i den."

#: blocks/slider-slide/block.json build/blocks/slider-slide/block.json
msgctxt "block title"
msgid "Slider Slide"
msgstr "Slide"

#: blocks/slider-slide/block.json build/blocks/slider-slide/block.json
msgctxt "block description"
msgid "A single slide within slider slides block."
msgstr "Et enkelt slide i en slider-blok."

#: blocks/slider/block.json build/blocks/slider/block.json
msgctxt "block title"
msgid "Slider"
msgstr "Slider"

#: blocks/slider/block.json build/blocks/slider/block.json
msgctxt "block description"
msgid "Slider block for displaying content in a sliding format."
msgstr "Slider-blok, der viser indhold som skiftende slides."

#: blocks/tab/block.json build/blocks/tab/block.json
msgctxt "block title"
msgid "Tab"
msgstr "Faneblad"

#: blocks/tab/block.json build/blocks/tab/block.json
msgctxt "block description"
msgid "A single tab panel. Place any blocks inside. Lives inside a Tabs block."
msgstr "Et enkelt fanebladspanel. Placér vilkårlige blokke i det. Ligger i en Faneblade-blok."

#: blocks/tabs/block.json build/blocks/tabs/block.json
msgctxt "block title"
msgid "Tabs"
msgstr "Faneblade"

#: blocks/tabs/block.json build/blocks/tabs/block.json
msgctxt "block description"
msgid "A tabbed container. Add Tab blocks inside and place any content in each tab."
msgstr "En container med faneblade. Tilføj Faneblad-blokke, og placér indhold i hvert faneblad."
